datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String
  passwordHash       String       @default("demo123")
  role               String       // "FINANCE_EXECUTIVE" | "CO_FOUNDER" | "RETURNS_MANAGER"
  department         String       @default("Finance")
  createdAt          DateTime     @default(now())
}

model Order {
  id                    String      @id @default(cuid())
  orderId               String      @unique // e.g. "ORD-W-204118", "ORD-M-88120", "ORD-W-204377"
  channel               String      // "Website", "Marketplace 1", "Marketplace 2", "Marketplace 3", "Quick-Commerce 1", "Quick-Commerce 2"
  orderDate             DateTime
  itemDescription       String      @default("300TC Cotton Bed Linen King")
  sku                   String      @default("BED-300TC-KING-01")
  orderValue            Float       // Gross order value (e.g. 1499, 1199, 2398)
  paymentMode           String      // "COD" | "Prepaid"
  deliveryStatus        String      // "Delivered" | "Returned to warehouse" | "In transit" | "RTO initiated" | "Lost in transit"
  courierPartner        String      @default("Shiprocket") // "Shiprocket" | "Delhivery"
  awbNumber             String      @default("AWB-98218731")
  physicalWeightKg      Float       @default(0.85) // Catalog / true physical weight
  billedWeightKg        Float       @default(0.85) // Courier freight billed weight
  expectedReceived      Float       // Computed by rate cards
  actualReceived        Float       // Received from settlements/COD remittance
  difference            Float       // actualReceived - expectedReceived
  reconciliationStatus  String      // "Settled" | "Short-paid" | "Unpaid past due" | "Freight overcharged" | "Return not received"
  leakageAmount         Float       @default(0.0)
  leakageReason         String      @default("None")
  tcsDeducted           Float       @default(0.0) // GST TCS 1%
  tdsDeducted           Float       @default(0.0) // Income Tax TDS 0.1% or 1%
  commissionDeducted    Float       @default(0.0)
  freightDeducted       Float       @default(0.0)
  codFeeDeducted        Float       @default(0.0)
  customerName          String      @default("Ananya Sharma")
  customerPhone         String      @default("+91 98450 12891")
  customerAddress       String      @default("42, 12th Main, Indiranagar, Bengaluru 560038")
  city                  String      @default("Bengaluru")
  zone                  String      @default("Metro") // "Local", "Regional", "Metro", "National"
  warehouseScanDate     DateTime?
  daysSinceDelivery     Int         @default(0)
  claimId               String?
  claimStatus           String      @default("None") // "None" | "Draft" | "Submitted" | "Under Review" | "Recovered" | "Rejected"
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model RateCard {
  id                    String      @id @default(cuid())
  type                  String      // "CHANNEL" | "COURIER"
  name                  String      // e.g. "Website", "Marketplace 1", "Shiprocket", "Delhivery"
  commissionPercent     Float       @default(0.0)
  fixedClosingFee       Float       @default(0.0)
  paymentGatewayPercent Float       @default(0.0)
  baseWeightGrams       Int         @default(500)
  baseRateLocal         Float       @default(38.0)
  baseRateRegional      Float       @default(48.0)
  baseRateMetro         Float       @default(62.0)
  baseRateNational      Float       @default(78.0)
  extraSlabRate         Float       @default(35.0) // Per 500g extra
  codFixedFee           Float       @default(35.0)
  codPercentFee         Float       @default(1.5)
  rtoChargePercent      Float       @default(100.0)
  tcsPercent            Float       @default(1.0)
  tdsPercent            Float       @default(0.1)
  isActive              Boolean     @default(true)
  updatedAt             DateTime    @updatedAt
}

model ColumnMapping {
  id                    String      @id @default(cuid())
  sourceType            String      // "ORDER_MASTER", "SETTLEMENT", "COD_REMITTANCE", "FREIGHT_INVOICE", "WAREHOUSE_SCAN"
  partnerName           String      // "Website", "Marketplace 1", "Marketplace 2", "Shiprocket", "Delhivery", etc.
  version               Int         @default(1)
  mappings              String      // JSON string of { targetField: sourceHeader }
  sampleData            String?     // JSON string of preview rows
  isApproved            Boolean     @default(false)
  approvedBy            String?
  approvedAt            DateTime?
  versionHistory        String?     // JSON array of prior versions for rollback
  createdAt             DateTime    @default(now())
}

model AIReviewQueueItem {
  id                    String      @id @default(cuid())
  partner               String
  rawPaymentRef         String
  rawAwb                String
  rawAmount             Float
  transactionDate       DateTime
  suggestedOrderId      String
  confidenceScore       Float
  matchReasons          String      // JSON array of signals
  status                String      @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED", "MANUALLY_LINKED"
  reviewedBy            String?
  reviewedAt            DateTime?
  auditNote             String?
  createdAt             DateTime    @default(now())
}

model Claim {
  id                    String      @id @default(cuid())
  claimNumber           String      @unique // e.g. "CLM-2026-1041"
  partner               String      // "Shiprocket", "Marketplace 1", "Delhivery", etc.
  orderId               String
  awbNumber             String
  discrepancyType       String      // "UNREMITTED_COD", "COMMISSION_OVERCHARGE", "WEIGHT_SLAB_ERROR", "LOST_RETURN"
  disputedAmount        Float
  status                String      @default("DRAFT") // "DRAFT", "SUBMITTED", "UNDER_REVIEW", "RECOVERED", "REJECTED"
  evidenceDossier       String      // JSON string detailing the discrepancy proof
  recoveryDate          DateTime?
  settlementUtr         String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model AuditLog {
  id                    String      @id @default(cuid())
  userId                String      @default("usr_exec")
  userName              String      @default("Priya Nair (Finance Executive)")
  action                String
  details               String
  timestamp             DateTime    @default(now())
}
